{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pa/receipt.schema.json",
  "title": "PA 统一结果回执（PRD v1.1 §7.3）",
  "type": "object",
  "required": ["status", "summary", "code_changed", "confidence", "risk", "evidence", "usage"],
  "additionalProperties": false,
  "properties": {
    "status": {"enum": ["succeeded", "failed", "needs_human", "blocked", "dropped"]},
    "summary": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["type", "ref"],
      "properties": {"type": {"enum": ["pr", "file", "text", "url"]}, "ref": {"type": "string"}}, "additionalProperties": false}},
    "code_changed": {"type": "boolean"},
    "draft": {"type": "boolean", "default": false},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "risk": {"enum": ["low", "medium", "high"]},
    "risk_reasons": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "uniqueItems": true, "items": {"enum": [
      "delete_data", "stop_service", "spend_money", "external_message",
      "product_direction", "secret_change", "permission_change"]}},
    "suggested_action": {"enum": ["close", "merge", "ask_owner", "retry"]},
    "human_action": {"type": "object", "required": ["question", "options"], "additionalProperties": false,
      "properties": {
        "question": {"type": "string", "minLength": 1, "description": "只能是一个具体问题"},
        "options": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "recommend": {"type": "string"},
        "why": {"type": "string", "maxLength": 60}}},
    "handback": {"type": "array", "items": {"type": "object", "required": ["event_id", "reason"],
      "properties": {"event_id": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "usage": {"type": "object", "required": ["input_tokens", "output_tokens", "duration_s"],
      "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0},
        "duration_s": {"type": "number", "minimum": 0}}, "additionalProperties": false}
  }
}
